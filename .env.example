# Salin jadi .env.local untuk pengembangan. ISI NILAI ASLI HANYA DI VERCEL.

# Base URL upstream (server-only, tanpa trailing slash).
SIPUTZX_BASE_URL=https://api.siputzx.my.id

# Batas request per IP per menit di API lokal (default 40).
RATE_LIMIT_PER_MINUTE=40

# Batas ukuran response upstream yang diproses, dalam byte (default 4194304 / 4 MB).
UPSTREAM_MAX_BYTES=4194304
